# ============================================================
# SALES BOT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- ANTHROPIC (Claude API) ---
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# --- GOOGLE PLACES API (Agente 1 — Prospector) ---
# Obter em: console.cloud.google.com → Places API
GOOGLE_PLACES_API_KEY=sua_chave_places_aqui

# --- GOOGLE OAUTH2 (Agente 7 — Gmail + Calendar) ---
# Guia: https://developers.google.com/gmail/api/quickstart/nodejs
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REFRESH_TOKEN=seu_refresh_token

# Email principal da conta Gmail que envia as mensagens
GMAIL_USER=seuemail@gmail.com
# App Password (não é a senha normal): conta Google → Segurança → Senhas de app
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- NETLIFY (Agente 3 — Deploy de Landing Pages) ---
# Obter em: app.netlify.com → User settings → Applications → Personal access tokens
NETLIFY_AUTH_TOKEN=seu_token_netlify

# Prefixo dos sites (ex: demo-salao-da-maria.netlify.app)
NETLIFY_SITE_PREFIX=demo-

# --- PUSHOVER (Notificações Push no Celular) ---
# Criar conta em: pushover.net — gratuito por 30 dias, depois $5 único
PUSHOVER_TOKEN=seu_app_token_pushover
PUSHOVER_USER=seu_user_key_pushover

# --- CALENDLY (Agente 7 — Links de Agendamento) ---
# Seu link pessoal do Calendly
CALENDLY_LINK=https://calendly.com/seu-usuario/30min

# --- CONFIGURAÇÕES DO SISTEMA ---
# Email do dono (você) para notificações de fallback
OWNER_EMAIL=seuemail@gmail.com

# Horário do cron (padrão: todo dia às 08:00)
# Formato: minuto hora dia-mes mes dia-semana
CRON_SCHEDULE=0 8 * * *

# URL do painel de aprovação (altere se usar domínio próprio)
APPROVAL_PANEL_URL=http://localhost:3000

# Porta do servidor web
PORT=3000

# Desativar notificações (útil em dev)
# NOTIFICACOES_ATIVAS=false

# Override de email do lead (para testes — não enviar para o lead real)
# LEAD_EMAIL_OVERRIDE=teste@meudominio.com
