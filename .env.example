# ============================================================
# SALES BOT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- ANTHROPIC (Claude API) — OBRIGATÓRIO ---
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# ============================================================
# WHATSAPP — escolha UM dos dois provedores abaixo
# ============================================================

# Provedor ativo: "zapi" (recomendado, pago) ou "wwebjs" (gratuito, precisa de QR)
WHATSAPP_PROVIDER=zapi

# --- OPÇÃO 1: Z-API (zapi.io) — Recomendado para produção ---
# Planos a partir de R$97/mês. Não precisa de celular conectado.
# Como obter: app.z-api.io → Criar instância → copiar Instance ID e Token
ZAPI_INSTANCE_ID=sua_instance_id
ZAPI_TOKEN=seu_token
ZAPI_CLIENT_TOKEN=seu_client_token

# --- OPÇÃO 2: whatsapp-web.js — Gratuito, requer QR code ---
# Ao iniciar o sistema, um QR code aparece no terminal.
# Escaneie com o WhatsApp do celular que vai enviar as mensagens.
# Não precisa preencher nenhuma variável extra para esta opção.
# Apenas mude WHATSAPP_PROVIDER=wwebjs acima.

# ============================================================

# --- GOOGLE PLACES API (Agente 1 — Prospecção real) ---
# Obter em: console.cloud.google.com → Places API → Credentials
# Sem esta chave, o sistema usa dados mock (bom para testar)
GOOGLE_PLACES_API_KEY=sua_chave_places_aqui

# --- GMAIL (Agente 7 — monitorar respostas + canal email) ---
GMAIL_USER=seuemail@gmail.com
# App Password: conta Google → Segurança → Verificação em 2 etapas → Senhas de app
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GOOGLE OAUTH2 (Agente 7 — monitorar respostas no Gmail) ---
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REFRESH_TOKEN=seu_refresh_token

# --- SURGE.SH (deploy automático das landing pages — GRATUITO) ---
# Crie uma conta grátis em surge.sh, depois gere um token com: npx surge token
SURGE_LOGIN=seuemail@gmail.com
SURGE_TOKEN=seu_token_surge
SURGE_PREFIX=sales-bot-

# --- PUSHOVER (notificações push no celular) ---
# pushover.net — gratuito 30 dias, depois $5 único
PUSHOVER_TOKEN=seu_app_token_pushover
PUSHOVER_USER=seu_user_key_pushover

# --- CALENDLY (Agente 7 — propor horários de call) ---
CALENDLY_LINK=https://calendly.com/seu-usuario/30min

# --- CONFIGURAÇÕES DO SISTEMA ---
OWNER_EMAIL=seuemail@gmail.com
APPROVAL_PANEL_URL=http://localhost:3000
PORT=3000
CRON_SCHEDULE=0 8 * * *
NOTIFICACOES_ATIVAS=true

# --- PAUSA MANUAL DE PROSPECÇÃO POR E-MAIL ---
# true = Agente 8 e Cadência param de enviar novos e-mails de prospecção/follow-up.
# Não afeta WhatsApp nem o monitoramento de respostas do Agente 7.
EMAIL_PROSPECCAO_PAUSADA=false

# --- PAUSA MANUAL DA BUSCA DE LEADS NOVOS ---
# true = Agente 1 não busca leads novos no Google Maps (pipeline diário roda vazio).
BUSCA_DE_LEADS_PAUSADA=false

# --- PAINEL DE ATIVAÇÃO (bots de clientes do produto "automação") ---
# Cada cliente ativo abre sua própria conexão WhatsApp isolada (whatsapp-web.js),
# cada uma com seu próprio Chromium. Limite de conexões simultâneas de cliente
# (não conta a conexão do vendedor). Ajuste pra cima só se a VPS tiver RAM sobrando
# (cada conexão extra custa ~150-300MB). Padrão: 3.
MAX_TENANT_WHATSAPP=3

# Override de destinatário para testes (não enviar para o lead real)
# LEAD_EMAIL_OVERRIDE=teste@meudominio.com
