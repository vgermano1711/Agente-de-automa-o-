{
  "name": "sales-bot",
  "version": "1.0.0",
  "description": "Sistema multi-agente de prospecção e venda de landing pages",
  "main": "dist/orchestrator.js",
  "scripts": {
    "setup": "node setup.js",
    "build": "tsc",
    "start": "npm run build && node dist/orchestrator.js",
    "dev": "ts-node orchestrator.ts",
    "dev:api": "ts-node api/server.ts",
    "run-now": "ts-node orchestrator.ts --run-now",
    "status": "pm2 status",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "puppeteer": "^22.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
